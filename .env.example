DJANGO_SECRET_KEY=change-me

# DEBUG задаётся не здесь, а модулем настроек: config.settings.development
# (DEBUG=True, по умолчанию для manage.py/pytest) или config.settings.prod
# (DEBUG=False, используется в Docker).

# Используется только в prod (Docker); в development ALLOWED_HOSTS=['*'].
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — только для prod (Docker Compose). Локальная разработка без
# Docker идёт на SQLite (db.sqlite3) и эти переменные не читает.
# В Docker Compose POSTGRES_HOST переопределяется на "db" (см. docker-compose.yml).
POSTGRES_DB=elektronik
POSTGRES_USER=elektronik
POSTGRES_PASSWORD=elektronik
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Только для prod (Docker) ---

# Домен сайта для Caddy (HTTPS-сертификат выпускается на него и на www.).
# На сервере: SITE_DOMAIN=elektronik.kz и ALLOWED_HOSTS=elektronik.kz,www.elektronik.kz
# Пусто/не задано — localhost (проверка прод-сборки на своей машине).
SITE_DOMAIN=localhost

# Почта (SMTP). Если EMAIL_HOST пустой — письма о заказах не отправляются,
# а пишутся в лог контейнера web (`docker compose logs web`).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@elektronik.kz
ADMIN_EMAIL=admin@elektronik.kz
