SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — единственная поддерживаемая БД (SQLite убран). В Docker
# Compose POSTGRES_HOST переопределяется на "db" (см. docker-compose.yml).
# Для локальной разработки без Docker: `docker compose up -d db` поднимет
# только Postgres с портом 5432, опубликованным на хост — значения ниже
# подходят и для этого случая.
POSTGRES_DB=elektronik
POSTGRES_USER=elektronik
POSTGRES_PASSWORD=elektronik
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
