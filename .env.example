SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Используются только когда проект запущен через docker-compose
# (см. docker-compose.yml). Без Docker и без POSTGRES_HOST в окружении
# Django автоматически использует SQLite для локальной разработки.
POSTGRES_DB=elektronik
POSTGRES_USER=elektronik
POSTGRES_PASSWORD=elektronik
POSTGRES_HOST=db
POSTGRES_PORT=5432
